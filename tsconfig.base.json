{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@sign/recognizer-contract": ["./packages/recognizer-contract/src/index.ts"],
      "@sign/recognizer-mock": ["./packages/recognizer-mock/src/index.ts"],
      "@sign/recognizer-mock/debug-panel": ["./packages/recognizer-mock/src/MockDebugPanel.tsx"],
      "@sign/recognizer-plugin": ["./packages/recognizer-plugin/src/index.ts"],
      "@sign/sign-ui": ["./packages/sign-ui/src/index.ts"],
      "@sign/sign-ui/camera-screen": ["./packages/sign-ui/src/SignCameraScreen.tsx"]
    }
  }
}
